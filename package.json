{
  "name": "@astronomic-dev/ui",
  "version": "0.1.1",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "description": "Restylable Astro components on semantic design tokens and Tailwind CSS v4: navbars, heroes, cards, forms, footers and more, with presets and dark mode.",
  "keywords": [
    "astro",
    "astro-component",
    "tailwindcss",
    "ui",
    "components",
    "design-tokens"
  ],
  "homepage": "https://astronomic.dev/ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astronomic-dev/astronomic-ui.git"
  },
  "bugs": {
    "url": "https://github.com/astronomic-dev/astronomic-ui/issues"
  },
  "license": "MIT",
  "files": [
    "src/"
  ],
  "exports": {
    "./tokens.css": "./src/styles/tokens.css",
    "./theme.css": "./src/styles/theme.css",
    "./presets/*.css": "./src/styles/presets/*.css",
    "./components/*": "./src/components/*",
    "./lib/*": "./src/lib/*",
    "./system": "./src/system/index.mjs",
    "./system/link": {
      "types": "./src/system/link.d.ts",
      "default": "./src/system/link.mjs"
    },
    "./system/virtual": {
      "types": "./src/system/virtual.d.ts"
    },
    "./system/samples/*": "./src/system/samples/*",
    "./system/tokens": "./src/system/tokens.ts",
    "./system/contrast": {
      "types": "./src/system/contrast.d.ts",
      "default": "./src/system/contrast.mjs"
    }
  },
  "dependencies": {
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "tailwindcss": "^4.3.0",
    "astro": "^7.0.0",
    "@astronomic-dev/search": "^0.2.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "astro": "^7.3.5"
  },
  "peerDependenciesMeta": {
    "@astronomic-dev/search": {
      "optional": true
    }
  }
}
